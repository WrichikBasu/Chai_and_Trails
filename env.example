# A template for .env, which both Django and Docker Compose read.
# .env holds live credentials and is excluded from version control;
# this template, with the secrets left blank, is committed in its place.

# Signs session cookies and password-reset tokens. Each installation needs its own,
# generated with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# The database. These three create the role and database the first time the
# container starts, and are what Django connects with afterwards.
DB_NAME=chai
DB_USER=chai
DB_PASSWORD=

# localhost for the Compose setup above. DB_PORT is the port published on the host.
DB_HOST=localhost
DB_PORT=5432
